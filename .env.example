# mailutils — configuração
#
# Copie para `.env` e ajuste. O `.env` está no `.gitignore` e nunca deve ser
# commitado. Este ficheiro é o modelo; nunca é lido directamente pelo código
# fora de desenvolvimento.
#
# Arranque em produção: `MAILUTILS_ENV=production` faz a aplicação RECUSAR
# arrancar sem `MAILUTILS_SECRET_KEY` forte e sem `MAILUTILS_PUBLIC_BASE_URL`
# em https. É deliberado — um arranque silenciosamente inseguro é pior do que
# não arrancar.

# ---------------------------------------------------------------- identidade --
# `development` | `production`
MAILUTILS_ENV=development

# OBRIGATÓRIO em produção, mínimo 32 caracteres. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem isto em desenvolvimento, a app gera um segredo aleatório por processo:
# reiniciar invalida todas as sessões.
MAILUTILS_SECRET_KEY=

# Nome usado no assunto e nos emails enviados. Também aparece no email do OTP.
MAILUTILS_MAIL_FROM_NAME=mailutils

# ------------------------------------------------------------------ pública --
# Base pública usada nas imagens da assinatura. **Tem de ser https:// em
# produção** — a imagem entra no email do destinatário e um http:// é marcado
# como conteúdo inseguro.
MAILUTILS_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Marca os cookies de sessão como `Secure`. Em produção é forçado a true.
MAILUTILS_HTTPS=0

# ------------------------------------------------------------------ dados ----
MAILUTILS_DB_PATH=var/mailutils.db
MAILUTILS_MEDIA_DIR=var/media

# ------------------------------------------------- primeiro utilizador ------
# Criado no primeiro arranque, de forma idempotente. A palavra-passe tem no
# mínimo 12 caracteres. Depois de criado, mudar isto aqui NÃO muda a senha —
# para isso, use /perfil.
MAILUTILS_ADMIN_EMAIL=
MAILUTILS_ADMIN_PASSWORD=

# ------------------------------------------------------------------- SMTP ----
# Backend de email: `smtp` | `console` (desenvolvimento) | `null` (testes).
# `console` escreve o email no stdout. Nunca usar `console` em produção.
MAILUTILS_MAIL_BACKEND=console

# Quando `MAILUTILS_MAIL_BACKEND=smtp`, `SMTP_HOST` é obrigatório.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
MAILUTILS_MAIL_FROM=mailutils@localhost

# ---------------------------------------------------------------- segurança --
# Duração da sessão, em dias.
MAILUTILS_SESSION_DAYS=30

# Segundo factor por email.
MAILUTILS_OTP_TTL_MINUTES=10
MAILUTILS_OTP_MAX_ATTEMPTS=5
MAILUTILS_OTP_COOLDOWN_SECONDS=60

# Dispositivos conhecidos por utilizador. Acima deste número o mais antigo é
# descartado, o que forçaria um novo segundo factor.
MAILUTILS_MAX_DEVICES=20

# Limitação de tentativas de login, por email+IP.
MAILUTILS_LOGIN_MAX_ATTEMPTS=5
MAILUTILS_LOGIN_WINDOW_MINUTES=15

# Convites.
MAILUTILS_INVITE_TTL_HOURS=72

# ------------------------------------------------------------------- logo ----
MAILUTILS_MAX_UPLOAD_BYTES=2097152
MAILUTILS_LOGO_MAX_PX=300
MAILUTILS_MAX_VISIBLE_LINKS=6

# ------------------------------------------------- listas de destinatários ---
#
# Estes limites não são afrouxáveis por configuração: são o que separa "envio em
# massa para quem pediu" de "envio em massa para quem calhou", e sem eles uma
# sessão válida é um relay de email bombing. Reduzi-los é legítimo e sensato;
# o valor por omissão é que foi escolhido para ser defensável. (NFR-18)

# Endereços por lista.
MAILUTILS_MAX_LIST_SIZE=5000

# Confirmações por confirmar, por utilizador e em todas as suas listas. É este
# o limite que trava o relay: pedir um código a um endereço que já está
# pendente não aumenta o contador, por isso o limite é verificado onde o
# pendente nasce — na importação e ao adicionar um endereço.
MAILUTILS_MAX_PENDING_CONFIRMATIONS=500

# Cooldown por endereço entre pedidos de código, em qualquer lista do
# utilizador. O mínimo é 1: com 0 o limite desaparece por configuração.
MAILUTILS_CONFIRM_COOLDOWN_SECONDS=60

# Validade do link de descadência. Muito mais longa que o do código de
# confirmação de propósito: quem se descadencia no primeiro dia tem de poder
# voltar atrás no trigésimo.
MAILUTILS_UNSUBSCRIBE_TOKEN_DAYS=30

# ------------------------------------------------------------------ envio ----
#
# Ligar isto torna a aplicação capaz de enviar email (T015, ainda por
# fazer). Por omissão está desligado, e `MAILUTILS_SENDER_POSTAL_ADDRESS` só é
# exigida quando se liga.

# Interruptor. Sem ele, a aplicação não envia nada.
MAILUTILS_SENDING_ENABLED=0

# Endereço postal do remetente. **Obrigatório** quando `MAILUTILS_SENDING_ENABLED=1`
# em produção: o arranque é recusado sem isto. Enviar email exige um remetente
# identificável — em Portugal e na União Europeia é uma exigência legal, e é uma
# exigência do produto antes de ser uma exigência da lei. (NFR-17)
# A suficiência jurídica disto **não** é garantida aqui: quem opera responde.
MAILUTILS_SENDER_POSTAL_ADDRESS=
